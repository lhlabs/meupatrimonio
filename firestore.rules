rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owns(userId) { return signedIn() && request.auth.uid == userId; }
    function emailVerified() { return signedIn() && request.auth.token.email_verified == true; }

    // Compatibilidade temporária com contas criadas antes da exigência de
    // verificação de e-mail. O UID continua obrigatório e o e-mail do perfil
    // precisa coincidir com o token autenticado. Remover esta exceção depois
    // que todas as contas legadas tiverem o e-mail confirmado.
    function legacyRootMatches(userId) {
      return owns(userId)
        && request.auth.token.email is string
        && exists(/databases/$(database)/documents/users/$(userId))
        && get(/databases/$(database)/documents/users/$(userId)).data.email == request.auth.token.email;
    }

    function canUsePrivateData(userId) {
      return owns(userId) && (emailVerified() || legacyRootMatches(userId));
    }

    function validDate(v) { return v is string && v.matches('^\\d{4}-\\d{2}-\\d{2}$'); }
    function validMonth(v) { return v is string && v.matches('^\\d{4}-\\d{2}$'); }
    function validMoney(v) { return v is number && v >= 0 && v < 1000000000; }
    function validDocumentId(v) { return v is string && v.matches('^[A-Za-z0-9_-]{1,160}$'); }
    function createdNow() { return request.resource.data.createdAt == request.time; }
    function createdAtUnchanged() { return request.resource.data.createdAt == resource.data.createdAt; }
    function updatedNow() { return request.resource.data.updatedAt == request.time; }

    function validBaseCategory(type, category) {
      return category is string
        && ((type == 'expense' && category in [
          'Moradia','Mercado','Restaurantes','Transporte','Veículo','Saúde','Academia','Pets',
          'Assinaturas','Lazer','Compras','Impostos','Seguros','Educação','Viagens',
          'Investimentos/Aportes','Outros'
        ]) || (type == 'income' && category in [
          'Salário','Benefícios','Renda extra','Investimentos','Reembolso','Venda','Outros'
        ]));
    }

    function validTransactionCategory(type, category) {
      return validBaseCategory(type, category)
        || (type == 'income' && category == 'Resgate de Patrimônio');
    }

    function validTransaction() {
      return request.resource.data.keys().hasOnly(['type','amount','category','description','date','recurring','sourceType','sourceId','createdAt'])
        && request.resource.data.keys().hasAll(['type','amount','category','description','date','recurring','createdAt'])
        && request.resource.data.type in ['income','expense']
        && request.resource.data.amount is number && request.resource.data.amount > 0 && request.resource.data.amount < 100000000
        && validDate(request.resource.data.date)
        && validTransactionCategory(request.resource.data.type, request.resource.data.category)
        && request.resource.data.description is string && request.resource.data.description.size() <= 80
        && request.resource.data.recurring is bool
        && (!request.resource.data.keys().hasAny(['sourceType']) || request.resource.data.sourceType in ['recurring','scheduled'])
        && (!request.resource.data.keys().hasAny(['sourceId']) || (request.resource.data.sourceId is string && request.resource.data.sourceId.size() <= 128))
        && request.resource.data.createdAt is timestamp;
    }

    function validPosition() {
      return request.resource.data.keys().hasOnly(['type','name','value','createdAt'])
        && request.resource.data.keys().hasAll(['type','name','value','createdAt'])
        && request.resource.data.type in ['asset','reserve','debt']
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 60
        && validMoney(request.resource.data.value)
        && request.resource.data.createdAt is timestamp;
    }

    function validPlanning() {
      return request.resource.data.keys().hasOnly(['monthlyContributionGoal','monthlySurplusGoal','dailySpendGoal','financialFreedomMonthlyCost','realReturn','reserveTargetMonths','updatedAt'])
        && validMoney(request.resource.data.monthlyContributionGoal)
        && validMoney(request.resource.data.monthlySurplusGoal)
        && validMoney(request.resource.data.dailySpendGoal)
        && validMoney(request.resource.data.financialFreedomMonthlyCost)
        && request.resource.data.realReturn is number && request.resource.data.realReturn >= 0 && request.resource.data.realReturn <= 20
        && request.resource.data.reserveTargetMonths is number && request.resource.data.reserveTargetMonths >= 1 && request.resource.data.reserveTargetMonths <= 24
        && request.resource.data.updatedAt is timestamp;
    }

    function validMonthlyGoal(monthId) {
      return request.resource.data.keys().hasOnly(['month','monthlySurplusGoal','dailySpendGoal','createdAt','updatedAt'])
        && request.resource.data.keys().hasAll(['month','monthlySurplusGoal','dailySpendGoal','createdAt','updatedAt'])
        && validMonth(request.resource.data.month)
        && request.resource.data.month == monthId
        && validMoney(request.resource.data.monthlySurplusGoal)
        && validMoney(request.resource.data.dailySpendGoal)
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
    }

    function validRecurring() {
      return request.resource.data.keys().hasOnly(['name','type','amount','category','description','dayOfMonth','startDate','endDate','active','createdAt','updatedAt'])
        && request.resource.data.keys().hasAll(['name','type','amount','category','description','dayOfMonth','startDate','endDate','active','createdAt','updatedAt'])
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 60
        && request.resource.data.type in ['income','expense']
        && request.resource.data.amount is number && request.resource.data.amount > 0 && request.resource.data.amount < 100000000
        && validBaseCategory(request.resource.data.type, request.resource.data.category)
        && request.resource.data.description is string && request.resource.data.description.size() <= 80
        && request.resource.data.dayOfMonth is number && request.resource.data.dayOfMonth >= 1 && request.resource.data.dayOfMonth <= 31
        && validDate(request.resource.data.startDate)
        && (request.resource.data.endDate == '' || validDate(request.resource.data.endDate))
        && request.resource.data.active is bool
        && request.resource.data.createdAt is timestamp && request.resource.data.updatedAt is timestamp;
    }

    function validScheduled() {
      return request.resource.data.keys().hasOnly(['name','type','amount','category','description','dueDate','frequency','status','createdAt','updatedAt'])
        && request.resource.data.keys().hasAll(['name','type','amount','category','description','dueDate','frequency','status','createdAt','updatedAt'])
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 60
        && request.resource.data.type in ['income','expense']
        && request.resource.data.amount is number && request.resource.data.amount > 0 && request.resource.data.amount < 100000000
        && validBaseCategory(request.resource.data.type, request.resource.data.category)
        && request.resource.data.description is string && request.resource.data.description.size() <= 80
        && validDate(request.resource.data.dueDate)
        && request.resource.data.frequency in ['once','annual']
        && request.resource.data.status in ['active','posted','cancelled']
        && request.resource.data.createdAt is timestamp && request.resource.data.updatedAt is timestamp;
    }

    match /users/{userId} {
      // Perfil-raiz visível somente ao próprio usuário. Novos perfis exigem
      // e-mail verificado. Alterações arbitrárias no perfil permanecem negadas.
      allow read: if owns(userId);
      allow create: if owns(userId)
        && emailVerified()
        && request.resource.data.keys().hasOnly(['createdAt','email'])
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.createdAt is timestamp
        && createdNow();
      allow update: if false;
      allow delete: if canUsePrivateData(userId);

      match /transactions/{txId} {
        allow read, delete: if canUsePrivateData(userId);
        allow create: if canUsePrivateData(userId) && validDocumentId(txId) && validTransaction() && createdNow();
        allow update: if canUsePrivateData(userId) && validDocumentId(txId) && validTransaction() && createdAtUnchanged();
      }

      match /positions/{positionId} {
        allow read, delete: if canUsePrivateData(userId);
        allow create: if canUsePrivateData(userId) && validDocumentId(positionId) && validPosition() && createdNow();
        allow update: if canUsePrivateData(userId) && validDocumentId(positionId) && validPosition() && createdAtUnchanged();
      }

      match /config/planning {
        allow read: if canUsePrivateData(userId);
        allow create, update: if canUsePrivateData(userId) && validPlanning() && updatedNow();
        allow delete: if canUsePrivateData(userId);
      }

      match /monthlyGoals/{monthId} {
        allow read: if canUsePrivateData(userId);
        allow create: if canUsePrivateData(userId) && validMonthlyGoal(monthId) && createdNow() && updatedNow();
        allow update: if canUsePrivateData(userId) && validMonthlyGoal(monthId) && createdAtUnchanged() && updatedNow();
        allow delete: if canUsePrivateData(userId);
      }

      match /recurring/{recurringId} {
        allow read, delete: if canUsePrivateData(userId);
        allow create: if canUsePrivateData(userId) && validDocumentId(recurringId) && validRecurring() && createdNow() && updatedNow();
        allow update: if canUsePrivateData(userId) && validDocumentId(recurringId) && validRecurring() && createdAtUnchanged() && updatedNow();
      }

      match /scheduled/{scheduledId} {
        allow read, delete: if canUsePrivateData(userId);
        allow create: if canUsePrivateData(userId) && validDocumentId(scheduledId) && validScheduled() && createdNow() && updatedNow();
        allow update: if canUsePrivateData(userId) && validDocumentId(scheduledId) && validScheduled() && createdAtUnchanged() && updatedNow();
      }
    }

    // Deny by default: qualquer caminho não listado acima permanece fechado.
    match /{document=**} { allow read, write: if false; }
  }
}
